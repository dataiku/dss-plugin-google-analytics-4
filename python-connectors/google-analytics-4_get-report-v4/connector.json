{
    "meta" : {
        "label": "Get Report (GA4)",
        "description": "Build a Google Analytics 4 report",
        "icon": "icon-bar-chart"
    },
    "readable": true,
    "writable": false,
    "kind": "PYTHON",
    "paramsPythonSetup": "browse_google_analytics_v4.py",
    "params": [
        {
            "name": "auth_type",
            "label": "Authentication type",
            "type": "SELECT",
            "description": "",
            "selectChoices": [
                {
                    "value": "credentials",
                    "label": "Credentials"
                },
                {
                    "value": "oauth",
                    "label": "Google Single Sign On"
                }
            ],
            "defaultValue": "credentials"
        },
        {
            "name": "credentials",
            "label": "Credentials",
            "type": "PRESET",
            "parameterSetId": "google-application-credentials",
            "visibilityCondition": "model.auth_type == 'credentials'"
        },
        {
            "name": "oauth_credentials",
            "label": "Google Single Sign On",
            "type": "PRESET",
            "parameterSetId": "oauth-credentials",
            "visibilityCondition": "model.auth_type == 'oauth'"
        },
        {
            "name": "property_id_select",
            "label": "Account",
            "type": "SELECT",
            "visibilityCondition": "model.credentials != null || model.oauth_credentials != null",
            "getChoicesFromPython": true,
            "triggerParameters": ["credentials", "oauth_credentials"]
        },
        {
            "name": "property_id",
            "label": "Account ID",
            "type": "STRING",
            "visibilityCondition": "model.property_id_select == 'dku_manual_select'"
        },
        {
            "name": "web_property_id_select",
            "label": "Web property",
            "type": "SELECT",
            "visibilityCondition": "model.property_id_select.length >= 0",
            "getChoicesFromPython": true,
            "triggerParameters": ["property_id_select", "property_id"]
        },
        {
            "name": "web_property_id",
            "label": "Web property ID",
            "type": "STRING",
            "visibilityCondition": "model.web_property_id_select == 'dku_manual_select'"
        },
        {
            "name": "profile_id",
            "label": "View ID",
            "type": "STRING",
            "visibilityCondition": "model.profile_id_select == 'dku_manual_select'"
        },
        {
            "name": "metrics_id_select",
            "label": "Metrics and Goals",
            "description": "max. 10 (min. 1 mandatory)",
            "type": "MULTISELECT",
            "visibilityCondition": "(model.profile_id_select != null) || (model.web_property_id_select != null) || (model.web_property_id != null)",
            "getChoicesFromPython": true,
            "triggerParameters": ["profile_id_select", "web_property_id_select", "web_property_id"]
        },
        {
            "name": "metrics_id",
            "label": "Metrics IDs",
            "type": "STRING",
            "visibilityCondition": "model.metrics_id_select == 'dku_manual_select'"
        },
        {
            "name": "dimensions_id_select",
            "label": "Dimensions",
            "description": "max. 9 (optional)",
            "type": "MULTISELECT",
            "visibilityCondition": "model.metrics_id_select.length > 0",
            "getChoicesFromPython": true,
            "triggerParameters": ["metrics_id_select"]
        },
        {
            "name": "dimensions_id",
            "label": "Dimensions IDs",
            "type": "STRING",
            "visibilityCondition": "model.dimensions_id_select == 'dku_manual_select'"
        },
        {
            "name": "segments_id",
            "label": "Segments IDs",
            "type": "STRING",
            "visibilityCondition": "model.segments_id_select == 'dku_manual_select'"
        },
        {
            "name": "date_separator",
            "type": "SEPARATOR",
            "description": "Time range",
            "visibilityCondition": "model.metrics_id_select.length > 0"
        },
        {
            "name": "is_date_entered_manually",
            "type": "BOOLEAN",
            "label": " ",
            "description": "Enter date manually",
            "defaultValue": false,
            "visibilityCondition": "model.metrics_id_select.length > 0"
        },
        {
            "name": "start_date",
            "type": "DATE",
            "label": " ",
            "description": "From",
            "visibilityCondition": "!model.is_date_entered_manually && model.metrics_id_select.length > 0"
        },
        {
            "name": "manual_start_date",
            "type": "STRING",
            "label": " ",
            "description": "From",
            "visibilityCondition": "model.is_date_entered_manually && model.metrics_id_select.length > 0"
        },
        {
            "name": "end_date",
            "type": "DATE",
            "label": " ",
            "description": "To",
            "visibilityCondition": "!model.is_date_entered_manually && model.metrics_id_select.length > 0"
        },
        {
            "name": "manual_end_date",
            "type": "STRING",
            "label": " ",
            "description": "To",
            "visibilityCondition": "model.is_date_entered_manually && model.metrics_id_select.length > 0"
        },
        {
            "name": "manual-time-doc-separator",
            "type": "SEPARATOR",
            "label": " ",
            "description": "Must be in format YYYY-MM-DD",
            "visibilityCondition": "model.is_date_entered_manually && model.metrics_id_select.length > 0"
        }
    ]
}
